{
  "version": 1,
  "purpose": "Permanent structured-data connector expansion for ISTAT PULSE. A source is never promoted to active feed until an official structured endpoint is verified and validated.",
  "policy": {
    "official_only": true,
    "no_scraped_search_results_as_data": true,
    "allowed_formats": [
      "json",
      "csv",
      "tsv",
      "xlsx",
      "xls",
      "xml",
      "rdf",
      "sdmx",
      "geojson",
      "zip"
    ],
    "statuses": [
      "candidate",
      "structured_endpoint_verified",
      "connector_ready",
      "feed_active",
      "blocked",
      "editorial_only"
    ]
  },
