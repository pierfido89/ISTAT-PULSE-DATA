    "mode": "automatic_and_manual",
    "timezone": "Europe/Rome",
    "scheduled_hours_local": ["06:00", "11:00", "16:00", "22:00"],
    "manual_trigger": "GitHub Actions workflow_dispatch",
    "workflow": ".github/workflows/observer-backfill-fast.yml",
    "rule": "Every refresh must process every configured source using its persisted adapter, API, feed, sitemap, SSL exception or official fallback. Connector logic lives in this repository and must not depend on chat state."
